{
  // Vista previa privada de la web en GitHub Codespaces.
  // Al abrir el Codespace se arranca un servidor estático y se abre la web en el navegador.
  // El puerto es privado: solo es accesible con la sesión de GitHub del propietario.
  "name": "Maran Abogados — vista previa",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "forwardPorts": [8765],
  "portsAttributes": {
    "8765": {
      "label": "Web Maran Abogados",
      "onAutoForward": "openBrowser"
    }
  },
  "postAttachCommand": {
    "web": "python -m http.server 8765 --bind 0.0.0.0"
  },
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md"]
    }
  },
  "hostRequirements": {
    "cpus": 2
  }
}
